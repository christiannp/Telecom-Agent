# CovMo Telecom Intelligence Platform — Environment Variables

# ── LLM / Ollama ────────────────────────────────────────────────────────────
OLLAMA_API_KEY=your_key_here
OLLAMA_API_BASE=https://ollama.com/v1
LLM_MODEL=ollama_chat/minimax-m2.5:cloud

# ── Simulation ─────────────────────────────────────────────────────────────
TELEMETRY_INTERVAL_MS=500
SIMULATION_DENSITY=15
UI_REFRESH_RATE=1

# ── RAN Thresholds ─────────────────────────────────────────────────────────
CONGESTION_THRESHOLD_PRB=80
CONFIDENCE_THRESHOLD=85
MASS_EGRESS_TA_PCT=0.70
SIGNAL_CLIFF_DB=15.0

# ── Weather ─────────────────────────────────────────────────────────────────
ENABLE_WEATHER=true
WEATHER_FALLBACK_RAIN_MM_HR=0.0

# ── Ports ───────────────────────────────────────────────────────────────────
API_PORT=8400
STREAMLIT_PORT=8500
ADK_PORT=8080
